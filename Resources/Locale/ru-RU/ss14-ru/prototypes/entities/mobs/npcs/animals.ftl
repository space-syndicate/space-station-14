    .suffix = { ent-SimpleMobBase.suffix }
ent-MobPossum = поссум
    .desc = "О поссум! Мой поссум!" -- Уолт Уитмен, 1865.
    .suffix = { ent-SimpleMobBase.suffix }
ent-MobPossumOld = поссум
    .desc = { ent-MobPossum.desc }
